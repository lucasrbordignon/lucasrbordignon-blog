---
import { getCollection, render } from "astro:content";
import Layout from "../../components/Layout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts
    .filter((post) => !post.data.draft)
    .map((post) => {
      const slug = post.id.replace(/\.(md|mdx)$/i, "");
      return {
        params: { slug },
        props: { post, slug },
      };
    });
}

const { post, slug } = Astro.props;
const { Content, headings } = await render(post);
const sectionHeadings = headings.filter((heading) => heading.depth === 2);

const postSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  url: new URL(`/blog/${slug}/`, Astro.site).toString(),
  author: {
    "@type": "Person",
    name: "Lucas Rodrigues Bordignon",
    url: "https://example.com/about/",
  },
  // Escape < so a post title/description can never close the <script> tag.
}).replace(/</g, "\\u003c");
---

<Layout
  title={`${post.data.title} — Lucas Rodrigues Bordignon`}
  description={post.data.description}
  canonicalPath={`/blog/${slug}/`}
  ogType="article"
>
  <script type="application/ld+json" is:inline set:html={postSchema} />
  <main class="content-shell">
    <div
      class="article-layout section"
      style="max-width: var(--max); padding-inline: 1.25rem;"
    >
      <aside class="article-toc" aria-label="Article sections">
        {
          sectionHeadings.length > 0 && (
            <nav>
              {sectionHeadings.map((heading) => (
                <a href={`#${heading.slug}`} data-heading-link={heading.slug}>
                  {heading.text}
                </a>
              ))}
            </nav>
          )
        }
      </aside>

      <article class="article-shell" data-pagefind-body>
        <header class="article-header">
          <p class="post-meta">
            <time datetime={post.data.date.toISOString()}>
              {
                post.data.date.toLocaleDateString("en", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                  timeZone: "UTC",
                })
              }
            </time>
          </p>
          <h1>{post.data.title}</h1>
          <p>{post.data.description}</p>
        </header>
        <div class="article-prose">
          <Content />
        </div>
        <section class="article-comments" aria-label="Comments">
          <div id="remark42"></div>
        </section>
      </article>
    </div>
  </main>

  <script>
    // Optional Remark42 comments. Point these at your own instance, or
    // remove the #remark42 section above to disable comments entirely.
    const REMARK_HOST = "https://comments.lucasrbordignon.dev";

    type Remark42 = {
      createInstance: (config: Record<string, unknown>) => {
        destroy: () => void;
      };
      changeTheme: (theme: "light" | "dark") => void;
    };
    const w = window as typeof window & {
      remark_config?: Record<string, unknown>;
      REMARK42?: Remark42;
    };

    let tocObserver: IntersectionObserver | undefined;
    let commentsInstance: { destroy: () => void } | undefined;
    let embedRequested = false;

    function initToc() {
      tocObserver?.disconnect();
      const headings = Array.from(
        document.querySelectorAll(".article-prose h2[id]"),
      );
      const links = new Map(
        Array.from(document.querySelectorAll("[data-heading-link]")).map(
          (link) => [link.getAttribute("data-heading-link"), link],
        ),
      );
      if (headings.length === 0 || links.size === 0) return;

      function setActive(id: string) {
        for (const link of links.values()) link.removeAttribute("aria-current");
        links.get(id)?.setAttribute("aria-current", "true");
      }

      setActive(headings[0].id);
      tocObserver = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort(
              (a, b) => a.boundingClientRect.top - b.boundingClientRect.top,
            )[0];
          if (visible?.target instanceof HTMLElement)
            setActive(visible.target.id);
        },
        { rootMargin: "-18% 0px -68% 0px", threshold: 0 },
      );
      for (const heading of headings) tocObserver.observe(heading);
    }

    // Map the active palette to Remark42's light/dark themes by the
    // luminance of --bg, so all palettes work without a hard-coded list.
    function paletteTheme(): "light" | "dark" {
      const bg = getComputedStyle(document.documentElement)
        .getPropertyValue("--bg")
        .trim();
      const hex = bg.replace("#", "");
      const full = hex.length === 3 ? [...hex].map((c) => c + c).join("") : hex;
      const luma =
        0.2126 * parseInt(full.slice(0, 2), 16) +
        0.7152 * parseInt(full.slice(2, 4), 16) +
        0.0722 * parseInt(full.slice(4, 6), 16);
      return luma > 128 ? "light" : "dark";
    }

    function initComments() {
      const node = document.getElementById("remark42");
      if (!node) {
        try {
          commentsInstance?.destroy();
        } catch {}
        commentsInstance = undefined;
        return;
      }
      // The comments service only exists on the public origin.
      if (
        window.location.hostname !== "lucasrbordignon.dev" &&
        window.location.hostname !== "lucasrbordignon.github.io"
      )
        return;

      w.remark_config = {
        host: REMARK_HOST,
        site_id: "lucasrbordignon",
        url: window.location.origin + window.location.pathname,
        theme: paletteTheme(),
        show_email_subscription: false,
      };

      if (w.REMARK42) {
        try {
          commentsInstance?.destroy();
        } catch {}
        commentsInstance = w.REMARK42.createInstance(w.remark_config);
      } else if (!embedRequested) {
        // embed.mjs self-initializes against #remark42 using remark_config.
        embedRequested = true;
        const script = document.createElement("script");
        script.src = `${REMARK_HOST}/web/embed.mjs`;
        script.type = "module";
        document.head.append(script);
      }
    }

    // <html> survives view transitions, so one observer follows palette
    // switches for the life of the session.
    new MutationObserver(() => {
      w.REMARK42?.changeTheme(paletteTheme());
      void updateMermaidTheme();
    }).observe(document.documentElement, { attributeFilter: ["data-palette"] });

    async function renderMermaid() {
      const elements = document.querySelectorAll(
        'pre[data-language="mermaid"]',
      );
      if (elements.length === 0) return;

      try {
        const { default: mermaid } =
          // @ts-ignore - Mermaid ESM import is not well-typed
          await import("https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs");

        const isDark = paletteTheme() === "dark";
        mermaid.initialize({
          startOnLoad: false,
          theme: isDark ? "dark" : "default",
          securityLevel: "loose",
          themeVariables: {
            fontFamily: "JetBrains Mono, var(--mono), monospace",
          },
        });

        for (const el of elements) {
          const codeEl = el.querySelector("code") || el;
          const code = codeEl.textContent ?? "";

          const container = document.createElement("div");
          container.className = "mermaid-container";
          container.dataset.originalCode = code;

          const renderTarget = document.createElement("div");
          renderTarget.className = "mermaid";
          renderTarget.textContent = code;
          container.appendChild(renderTarget);

          el.parentNode?.replaceChild(container, el);
        }

        await mermaid.run();
      } catch (err) {
        console.error("Failed to render Mermaid diagrams:", err);
      }
    }

    async function updateMermaidTheme() {
      const containers = document.querySelectorAll(".mermaid-container");
      if (containers.length === 0) return;

      try {
        const { default: mermaid } =
          // @ts-ignore - Mermaid ESM import is not well-typed
          await import("https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs");

        const isDark = paletteTheme() === "dark";
        mermaid.initialize({
          startOnLoad: false,
          theme: isDark ? "dark" : "default",
          securityLevel: "loose",
          themeVariables: {
            fontFamily: "JetBrains Mono, var(--mono), monospace",
          },
        });

        for (const container of containers) {
          const code = (container as HTMLElement).dataset.originalCode ?? "";
          container.innerHTML = "";

          const renderTarget = document.createElement("div");
          renderTarget.className = "mermaid";
          renderTarget.textContent = code;
          container.appendChild(renderTarget);
        }

        await mermaid.run();
      } catch (err) {
        console.error("Failed to update Mermaid theme:", err);
      }
    }

    function init() {
      initToc();
      initComments();
      void renderMermaid();
    }

    init();
    // Module scripts run once per session; re-init after view-transition
    // navigations (e.g. post → post through the archive tree).
    document.addEventListener("astro:page-load", init);
  </script>
</Layout>

<style is:global>
  .mermaid-container {
    display: flex;
    justify-content: center;
    margin-block: 2.5rem;
    width: 100%;
    overflow-x: auto;
    background: var(--bg-elevated);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 1.5rem;
  }
  .mermaid {
    width: 100%;
    max-width: 100%;
    display: flex;
    justify-content: center;
  }
  .mermaid svg {
    background: transparent !important;
  }
  .mermaid text {
    font-family: var(--mono) !important;
  }
</style>
