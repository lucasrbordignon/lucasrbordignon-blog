---
import Layout from "../components/Layout.astro";
---

<Layout
  title="404 — Palette"
  description="Página não encontrada."
  canonicalPath="/404/"
>
  <main class="content-shell">
    <div class="page-hero">
      <p class="eyebrow">
        <span class="status-dot dot-blue"></span>página não encontrada
      </p>
      <h1>404</h1>
      <p class="hero-lede">
        Essa página não existe. Ela pode ter sido movida, deletada ou nunca
        publicada.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="/">Página inicial</a>
        <a class="button button-secondary" href="/blog/">Blog</a>
      </div>
    </div>
  </main>
</Layout>
