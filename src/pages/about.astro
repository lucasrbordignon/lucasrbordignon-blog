---
import Layout from "../components/Layout.astro";
import TypedLede from "../components/TypedLede.astro";
import SkillsMarquee from "../components/SkillsMarquee.astro";
---

<Layout
  title="Sobre — Lucas Rodrigues Bordignon"
  description="Curioso por natureza, curioso por software. Desenvolvedor focado em performance e cloud. Escrevo e compartilho aqui sobre tecnologia e código."
  canonicalPath="/about/"
>
  <main class="content-shell" data-pagefind-body>
    <div class="page-hero">
      <h1 class="visually-hidden">Sobre</h1>
      <TypedLede
        text="Curioso por natureza, curioso por software. Desenvolvedor focado em performance e cloud. Escrevo e compartilho aqui sobre tecnologia e código."
      />
    </div>

    <div class="section" style="max-width: var(--max);">
      <div class="about-grid">
        <div class="about-me">
          <div class="about-card">
            <h3>Sobre</h3>
            <div class="about-prose">
              <p>
                Software Engineer com mais de cinco anos de experiência
                projetando, desenvolvendo e evoluindo sistemas corporativos de
                missão crítica.
              </p>
              <p>
                Minha atuação vai além da implementação de funcionalidades.
                Trabalho desde o entendimento do problema de negócio,
                levantamento de requisitos e modelagem de processos até a
                definição da arquitetura, desenvolvimento, implantação e
                sustentação em produção.
              </p>
              <p>
                Tenho facilidade para compreender fluxos complexos, identificar
                gargalos operacionais e transformar processos de negócio em
                soluções simples, escaláveis e sustentáveis.
              </p>
              <p>
                Ao longo da carreira participei do desenvolvimento de ERPs,
                sistemas de RH, plataformas financeiras, WMS, aplicações
                comerciais, sistemas fiscais e tributários, plataformas de
                vendas nacionais e aplicações mobile.
              </p>
              <p>
                Atuo principalmente com Go, Node.js, TypeScript, React,
                PostgreSQL, Redis, Docker, Kubernetes e AWS, sempre buscando
                simplicidade arquitetural, alta disponibilidade, automação e
                performance.
              </p>
              <p>
                Meu principal interesse é evoluir para posições de Software
                Engineer e Platform Engineer, atuando na construção de
                plataformas, infraestrutura e arquitetura de sistemas
                distribuídos.
              </p>
            </div>
          </div>
        </div>

        <aside>
          <div class="sidebar-card">
            <h3>Formação</h3>
            <div class="edu-entry">
              <p class="edu-degree">Pós-graduação em DevOps</p>
              <p class="edu-school">
                <a
                  href="https://estacio.br/"
                  target="_blank"
                  rel="noopener"
                  style="color: var(--accent);">Estácio</a
                > · 2026 – 2027
              </p>
            </div>
            <div class="edu-entry">
              <p class="edu-degree">Bacharel em Ciência da Computação</p>
              <p class="edu-school">
                <a
                  href="https://www.unifran.edu.br/"
                  target="_blank"
                  rel="noopener"
                  style="color: var(--accent);">Universidade de Franca</a
                > · 2021 – 2025
              </p>
            </div>
          </div>
        </aside>
      </div>
    </div>

    <SkillsMarquee />
  </main>
</Layout>
